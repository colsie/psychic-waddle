<script>
const key='cp2077-story-guide-checks-v1';
let state={};
try{state=JSON.parse(localStorage.getItem(key)||'{}')}catch(e){}
const checks=[...document.querySelectorAll('.check')];
checks.forEach(c=>{
  c.checked=!!state[c.id];
  c.addEventListener('change',()=>{state[c.id]=c.checked;localStorage.setItem(key,JSON.stringify(state));updateProgress();});
});
function updateProgress(){
  const active=document.querySelector('.tab.active');
  const cs=[...active.querySelectorAll('.check')];
  const done=cs.filter(c=>c.checked).length;
  document.getElementById('count').textContent=`${done} / ${cs.length}`;
  document.getElementById('bar').style.width=(cs.length?done/cs.length*100:0)+'%';
}
document.querySelectorAll('nav button').forEach(b=>b.addEventListener('click',()=>{
  document.querySelectorAll('nav button').forEach(x=>x.classList.toggle('active',x===b));
  document.querySelectorAll('.tab').forEach(x=>x.classList.toggle('active',x.id===b.dataset.tab));
  window.scrollTo(0,0); updateProgress();
}));
function clearVisible(){
  const active=document.querySelector('.tab.active');
  if(!confirm('Clear the checkmarks in this guide?')) return;
  active.querySelectorAll('.check').forEach(c=>{c.checked=false;state[c.id]=false;});
  localStorage.setItem(key,JSON.stringify(state)); updateProgress();
}
updateProgress();
</script>
