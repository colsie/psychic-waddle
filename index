<style>
:root {
  --bg:#101317; --panel:#171c22; --text:#f2f3f5; --muted:#aeb6c0;
  --main:#284f39; --secondary:#65472d; --free:#274a70; --line:#303842;
  --accent:#f2d43d;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;line-height:1.45}
header{position:sticky;top:0;z-index:20;background:rgba(16,19,23,.96);backdrop-filter:blur(12px);border-bottom:1px solid var(--line);padding:calc(10px + env(safe-area-inset-top)) 14px 10px}
h1{font-size:18px;margin:0 0 8px;line-height:1.15}
.progress-wrap{display:flex;align-items:center;gap:10px;font-size:12px;color:var(--muted)}
.progress{height:7px;background:#262d35;border-radius:99px;overflow:hidden;flex:1}
.progress>div{height:100%;width:0;background:var(--accent);transition:width .2s}
nav{display:flex;gap:7px;overflow-x:auto;padding:9px 12px;border-bottom:1px solid var(--line);background:#12161b;position:sticky;top:78px;z-index:19}
nav button{white-space:nowrap;border:1px solid var(--line);background:#1b2128;color:var(--text);border-radius:999px;padding:8px 12px;font-weight:650}
nav button.active{background:var(--accent);color:#111;border-color:var(--accent)}
main{max-width:760px;margin:auto;padding:14px 12px calc(50px + env(safe-area-inset-bottom))}
.tab{display:none} .tab.active{display:block}
.section-title,.act{margin:24px 2px 10px}
.section-title{font-size:20px}
.act{font-size:23px;padding-top:8px;border-top:1px solid var(--line)}
.prose{white-space:normal;background:var(--panel);border:1px solid var(--line);padding:14px;border-radius:12px;margin:0 0 14px}
.quest{display:flex;gap:11px;padding:13px 12px;margin:8px 0;border:1px solid var(--line);border-radius:12px;background:var(--panel);align-items:flex-start}
.quest.main{border-left:5px solid #79a985;background:linear-gradient(90deg,rgba(54,103,73,.35),var(--panel) 45%)}
.quest.secondary{border-left:5px solid #c48a52;background:linear-gradient(90deg,rgba(116,79,43,.32),var(--panel) 45%)}
.quest.free{border-left:5px solid #6d9ed2;background:linear-gradient(90deg,rgba(48,89,132,.35),var(--panel) 45%)}
.quest input{position:absolute;opacity:0;pointer-events:none}
.box{width:24px;height:24px;min-width:24px;border:2px solid #89939e;border-radius:7px;margin-top:1px;display:grid;place-items:center}
input:checked + .box{background:var(--accent);border-color:var(--accent)}
input:checked + .box:after{content:"✓";color:#111;font-weight:900}
.quest:has(input:checked) .quest-body{opacity:.48}
.quest:has(input:checked) .quest-name{text-decoration:line-through}
.quest-body{display:block;min-width:0;flex:1}
.quest-top{display:flex;justify-content:space-between;gap:10px;align-items:flex-start}
.quest-name{font-weight:780;font-size:16px}
.time{display:inline-block;color:#f3d978;font-weight:720;font-size:12px;white-space:nowrap}
.notes{display:block;color:#d3d8de;font-size:14px;margin-top:5px}
.note-row{margin-top:-5px;background:#13181e}
.note-spacer{width:24px;min-width:24px}
.day-break{height:28px;display:flex;align-items:center;gap:8px;color:#7f8994;font-size:10px;text-transform:uppercase;letter-spacing:.13em}
.day-break:before,.day-break:after{content:"";height:1px;background:var(--line);flex:1}
.legend{display:flex;flex-wrap:wrap;gap:8px;margin:6px 0 16px;color:var(--muted);font-size:12px}
.pill{border-radius:99px;padding:4px 8px;border:1px solid var(--line)}
.controls{display:flex;gap:8px;margin:8px 0 14px}
.controls button{border:1px solid var(--line);background:#1b2128;color:var(--text);padding:8px 11px;border-radius:9px}
.small{font-size:12px;color:var(--muted)}
@media (max-width:430px) {
  header{padding-left:12px;padding-right:12px}
  nav{top:78px}
  .quest{padding:12px 10px}
  .quest-top{display:block}
  .time{margin-top:3px}
}
</style>
